+@pytest.fixture
+def game(tmp_path):
+    path = tmp_path / 'test.sqlite3'
+    app = create_app(path)
+    with TestClient(app) as c:
+        c.headers.update(HEADERS)
+        data = c.post('/api/v1/session', json={'name': 'Thuyền trưởng Mèo'}).json()
+        c.headers['x-csrf-token'] = data['csrf']
+        yield c, path
