# Copy to .env.local for the Next.js LOCAL development server only.
# Python does not read this file automatically: export the variables in its shell,
# or use the systemd EnvironmentFile workflow documented in README.md.
BACKEND_URL=http://127.0.0.1:8000
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=0
# Optional Python-only override. Default is backend/data/game.sqlite3.
# DATABASE_PATH=/absolute/path/to/game.sqlite3
